# TS3 Analytics – Konfiguration
# Kopieren nach .env und Werte anpassen. .env niemals committen.
# Leere Werte gelten als nicht gesetzt (Standardwert greift bzw. Pflichtfeld fehlt).

# --- TeamSpeak ServerQuery (SSH) ---
TS3_HOST=127.0.0.1
TS3_QUERY_PORT=10022
# Pflicht
TS3_QUERY_USER=
# Pflicht
TS3_QUERY_PASSWORD=
# Virtuelle Server-ID
TS3_SERVER_ID=1
# Max. 30 Zeichen
TS3_BOT_NICKNAME=TS3 Analytics
# Max. Query-Befehle pro Sekunde (Anti-Flood)
TS3_QUERY_RATE_LIMIT=5

# --- Sicherheit ---
# Pflicht, mind. 32 Zeichen. Erzeugen z. B. mit: openssl rand -hex 32
# Nach Inbetriebnahme nicht mehr ändern, sonst passen gespeicherte IP-Hashes nicht mehr zusammen.
HMAC_SECRET=

# --- Webinterface ---
# Nur Loopback erlaubt: 127.0.0.1, ::1 oder localhost
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Login-Sitzung läuft nach so vielen Stunden ohne Aktivität ab (1–720)
SESSION_TTL_HOURS=12
# Cookie nur über HTTPS senden (nur hinter einem TLS-Proxy aktivieren)
WEB_COOKIE_SECURE=false

# --- Pfade ---
GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb
SQLITE_PATH=./data/ts3-analytics.sqlite
# Tägliche Online-Sicherung der Datenbank und Anzahl aufbewahrter Sicherungen (1–365)
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# --- SQLite-Tuning ---
# Seiten-Cache pro Verbindung in MB
SQLITE_CACHE_SIZE_MB=64
# Memory-Mapped I/O in MB (0 = aus)
SQLITE_MMAP_SIZE_MB=256

# --- Watcher ---
# Abstand der Clientlisten-Abfragen in Sekunden (10–600)
POLL_INTERVAL_S=60
# Aktivitätssegmente werden gesammelt alle X Sekunden geschrieben (30–3600)
SEGMENT_FLUSH_INTERVAL_S=300
# Neustarts des Dienstes, die kürzer sind, setzen laufende Sessions fort (0 = immer beenden)
SESSION_RESUME_GRACE_S=300
# Banliste vom Server spiegeln alle X Sekunden (60–86400)
BAN_SYNC_INTERVAL_S=600
# Server-Log auf Servergruppen-Änderungen prüfen alle X Sekunden (10–3600).
# Braucht das Recht b_virtualserver_log_view für den Query-Account.
GROUP_LOG_INTERVAL_S=30

# --- Datenschutz ---
# Aufbewahrung gehashter IP-Daten in Tagen
IP_RETENTION_DAYS=90
# Rohdaten der Aktivitätssegmente nach X Monaten löschen (0 = behalten).
# Tages- und Gesamtstatistiken bleiben immer erhalten; gelöschte Zeiträume lassen sich
# danach aber nicht mehr per stats:rebuild neu berechnen.
SEGMENT_RETENTION_MONTHS=0

# --- Logging ---
# fatal, error, warn, info, debug, trace oder silent
LOG_LEVEL=info
LOG_DIR=./data/logs
# Anzahl täglicher Log-Dateien, die zusätzlich zur aktuellen aufbewahrt werden
LOG_RETENTION_DAYS=14
# true/false; leer = lesbare Ausgabe nur, wenn die Konsole ein Terminal ist
LOG_PRETTY=
