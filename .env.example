# TS3 Analytics – Konfiguration
# Kopieren nach .env und Werte anpassen. .env niemals committen.
# Leere Werte gelten als nicht gesetzt (Standardwert greift bzw. Pflichtfeld fehlt).

# --- TeamSpeak ServerQuery (SSH) ---
TS3_HOST=127.0.0.1
TS3_QUERY_PORT=10022
# Pflicht
TS3_QUERY_USER=
# Pflicht
TS3_QUERY_PASSWORD=
# Virtuelle Server-ID
TS3_SERVER_ID=1
# Max. 30 Zeichen
TS3_BOT_NICKNAME=TS3 Analytics
# Max. Query-Befehle pro Sekunde (Anti-Flood)
TS3_QUERY_RATE_LIMIT=5

# --- Sicherheit ---
# Pflicht, mind. 32 Zeichen. Erzeugen z. B. mit: openssl rand -hex 32
# Nach Inbetriebnahme nicht mehr ändern, sonst passen gespeicherte IP-Hashes nicht mehr zusammen.
HMAC_SECRET=

# --- Webinterface ---
# Nur Loopback erlaubt: 127.0.0.1, ::1 oder localhost
WEB_HOST=127.0.0.1
WEB_PORT=8080

# --- Pfade ---
GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb
SQLITE_PATH=./data/ts3-analytics.sqlite

# --- Datenschutz ---
# Aufbewahrung gehashter IP-Daten in Tagen
IP_RETENTION_DAYS=90

# --- Logging ---
# fatal, error, warn, info, debug, trace oder silent
LOG_LEVEL=info
LOG_DIR=./data/logs
# Anzahl täglicher Log-Dateien, die zusätzlich zur aktuellen aufbewahrt werden
LOG_RETENTION_DAYS=14
# true/false; leer = lesbare Ausgabe nur, wenn die Konsole ein Terminal ist
LOG_PRETTY=
