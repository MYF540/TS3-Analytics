{
  "name": "ts3-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "TeamSpeak 3 watcher with statistics, leaderboards, admin tools and automatic rank system",
  "license": "AGPL-3.0-only",
  "author": "MYF540",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYF540/TS3-Analytics.git"
  },
  "homepage": "https://github.com/MYF540/TS3-Analytics#readme",
  "bugs": {
    "url": "https://github.com/MYF540/TS3-Analytics/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite web",
    "build": "tsc -p tsconfig.build.json && tsc --noEmit -p web && vite build web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "tsc --noEmit -p web && vite build web",
    "start": "node dist/main.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run && vitest run --root web",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "stats:rebuild": "tsx src/cli/stats-rebuild.ts",
    "backup": "tsx src/cli/backup.ts",
    "import:logs": "tsx src/cli/import-logs.ts",
    "import:ranking": "tsx src/cli/import-ranking.ts",
    "seed:synthetic": "tsx src/cli/seed-synthetic.ts",
    "bench": "tsx src/cli/bench.ts",
    "admin:user": "tsx src/cli/admin-user.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "maxmind": "^5.0.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "ts3-nodejs-library": "^3.5.3",
    "zod": "^4.6.5"
  }
}
